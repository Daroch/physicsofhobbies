---
// Caja de autor al pie de cada artículo. Da a la persona una presencia visible
// y enlazable en todas las páginas de contenido, no solo en /sobre-mi.
// Deliberadamente breve: las titulaciones no se repiten aquí (sonaban a
// currículum en cada post). Viven en /sobre-mi y en el JSON-LD `Person`, que es
// lo que lee Google — así que acortar esto no debilita la señal de autoría.
import { AUTHOR } from '../config/site';

const linkedin = AUTHOR.profiles.linkedin;
const github = AUTHOR.profiles.github;
---
<aside class="author-box">
  <img class="author-avatar" src={AUTHOR.avatar} alt={`Avatar de ${AUTHOR.name}`} width="112" height="112" loading="lazy" />
  <div class="author-body">
    <span class="eyebrow author-eyebrow"><span class="dot"></span>Escrito por {AUTHOR.name}</span>
    <p class="author-bio">{AUTHOR.shortBio}</p>
    <div class="author-links">
      <a href={AUTHOR.page}>Sobre el autor</a>
      <a href="/metodologia/">Metodología</a>
      {linkedin && <a href={linkedin} target="_blank" rel="me noopener">LinkedIn</a>}
      {github && <a href={github} target="_blank" rel="me noopener">GitHub</a>}
    </div>
  </div>
</aside>

<style>
  .author-box {
    margin-top: 3rem;
    padding: 1.5rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .author-avatar {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--ink);
  }
  .author-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }
  .author-eyebrow { color: var(--signal-ink); }
  .author-bio {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0.4rem 0 0;
  }
  .author-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.7rem;
  }
  .author-links a {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--signal-ink);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--signal) 40%, transparent);
    padding-bottom: 1px;
  }
  .author-links a:hover { border-bottom-color: var(--signal); }

  @media (max-width: 720px) {
    .author-box { gap: 1rem; padding: 1.25rem; }
    .author-avatar { width: 48px; height: 48px; }
  }
</style>
