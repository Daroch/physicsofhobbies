---
// src/components/PostCard.astro
const { post } = Astro.props;
const { title, description, category, image } = post.data;
const postSlug = post.slug || post.id.replace(/\.[^/.]+$/, "");
const cat = (category || 'general').toLowerCase();

// Fallback local: el sitio no carga recursos de terceros (ver /privacidad).
const fallbackImage = "/images/default-physics.png";
---
<article class="card">
  <a href={`/blog/${post.id}`} class="image-link">
    <div class="image-wrapper photo-surface">
      <img src={image || fallbackImage} alt={title} loading="lazy" />
    </div>
  </a>

  <div class="content">
    <span class="eyebrow" data-cat={cat}>
      <span class="dot"></span>
      {category || 'General'}
    </span>
    <h2 class="title">{title}</h2>
    <p class="excerpt">{description}</p>
    <a href={`/blog/${post.id}`} class="read-more">
      Leer más
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </a>
  </div>
</article>

<style>
  .card {
    background: var(--panel);
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: border-color 0.2s, transform 0.2s;
  }
  .card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent 0%, var(--signal) 50%, transparent 100%);
    opacity: 0;
    transition: opacity 0.25s;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--signal) 30%, var(--line));
  }
  .card:hover::before { opacity: 1; }

  .image-wrapper {
    position: relative;
    width: 100%;
    /* 4:3 en vez de 16:9: más cerca de la proporción real de las fotos de
       producto (mediana ≈ 1.0), así el producto se ve más grande. */
    aspect-ratio: 4 / 3;
    border-bottom: 1px solid var(--line);
  }

  img {
    padding: 1rem;
    transition: transform 0.4s ease;
  }

  .card:hover img { transform: scale(1.03); }

  .content {
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 0.6rem;
  }

  .title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0;
    color: var(--ink);
    line-height: 1.3;
  }

  .excerpt {
    font-size: 0.92rem;
    color: var(--muted);
    margin: 0 0 0.5rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.6;
  }

  .read-more {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--signal-ink);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.85rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: gap 0.2s;
  }

  .read-more:hover { gap: 0.55rem; }
</style>
