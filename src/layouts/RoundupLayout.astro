---
// src/layouts/RoundupLayout.astro
import Layout from './Layout.astro';
import AuthorBox from '../components/AuthorBox.astro';

interface Product {
  name: string;
  shortName?: string;
  tier?: string;
  image: string;
  amazonUrl: string;
  price?: number;
  rating?: number;
  reviews?: number;
  highlight: string;
  specs?: string[];
}

interface Props {
  /** Título de la pestaña/SEO, con sufijo del sitio. */
  title: string;
  /** Slug del post. Solo para etiquetar los eventos de clic a Amazon. */
  postId: string;
  /** Titular visible del post, sin sufijo. */
  heading: string;
  description: string;
  image?: string;
  category?: string;
  pubDate: Date;
  products: Product[];
  structuredData?: Record<string, unknown>;
  audience?: string;
  specsThatMatter?: { spec: string; why: string }[];
  chooseBy?: { scenario: string; priority: string }[];
  comparison?: { columns: string[]; derivedNote?: string };
  pitfalls?: { claim: string; reality: string }[];
  verdicts?: { profile: string; pick: string; why: string }[];
}

const {
  title, postId, heading, description, image, category, pubDate, products, structuredData,
  audience, specsThatMatter, chooseBy, comparison, pitfalls, verdicts,
} = Astro.props;
const cat = (category || 'general').toLowerCase();

// La tabla solo se pinta si hay cabeceras y al menos un producto las rellena.
const hasTable = !!comparison?.columns?.length && products.some((p) => p.specs?.length);

// Amazon comparte un mismo contador de reseñas entre productos distintos del
// mismo vendedor. Visto en soldadores (2026-08-22): dos Beizkna que no son el
// mismo aparato mostraban ★4,4 y 8.915 reseñas cada uno. Repetido en dos
// tarjetas contiguas parece un error de nuestros datos, y peor aún, invita a
// leer la cifra como si validara cada producto por separado. No lo hace.
// No se oculta el dato —está en la ficha— pero se marca para que no engañe.
const firmaResenas = (p: Product) =>
  p.rating != null && p.reviews != null ? `${p.rating}|${p.reviews}` : null;
const vecesPorFirma = new Map<string, number>();
for (const p of products) {
  const f = firmaResenas(p);
  if (f) vecesPorFirma.set(f, (vecesPorFirma.get(f) ?? 0) + 1);
}
const esCompartida = (p: Product) => {
  const f = firmaResenas(p);
  return !!f && (vecesPorFirma.get(f) ?? 0) > 1;
};
const hayResenasCompartidas = products.some(esCompartida);
---

<Layout title={title} description={description} image={image} type="article" structuredData={structuredData}>
  <div class="post-hero grid-paper">
    <div class="container">
      <div class="hero-content">
        <span class="eyebrow" data-cat={cat}><span class="dot"></span>Comparativa · {category || 'Física'}</span>
        <h1 class="post-title">{heading}</h1>
        <div class="post-meta">
          <time>{pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
          <span class="tick"></span>
          <span>Lectura de 6 min</span>
        </div>
      </div>
    </div>
    <div class="trace-rule"></div>
  </div>

  <main class="post-main">
    {audience && (
      <section class="audience">
        <span class="eyebrow" data-cat={cat}><span class="dot"></span>Para quién es</span>
        <p>{audience}</p>
      </section>
    )}

    <article class="prose prose-slate lg:prose-lg mx-auto prose-headings:font-bold prose-a:text-[color:var(--signal-ink)] prose-img:rounded-lg">
      <slot />
    </article>

    {specsThatMatter && specsThatMatter.length > 0 && (
      <section class="block">
        <h2>Qué specs importan, y por qué</h2>
        <dl class="spec-list">
          {specsThatMatter.map((s) => (
            <div class="spec-item">
              <dt>{s.spec}</dt>
              <dd>{s.why}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {chooseBy && chooseBy.length > 0 && (
      <section class="block">
        <h2>Cómo elegir según tu caso</h2>
        <ul class="choose-list">
          {chooseBy.map((c) => (
            <li>
              <span class="choose-if">Si {c.scenario}</span>
              <span class="choose-arrow">→</span>
              <span class="choose-then">{c.priority}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {hasTable && (
      <section class="block">
        <h2>Comparativa</h2>
        <div class="table-scroll">
          <table class="compare-table">
            <thead>
              <tr>
                <th scope="col">Producto</th>
                {comparison!.columns.map((c) => <th scope="col">{c}</th>)}
              </tr>
            </thead>
            <tbody>
              {products.map((p) => (
                <tr>
                  <th scope="row">{p.shortName ?? p.name}</th>
                  {comparison!.columns.map((_, i) => {
                    const v = p.specs?.[i] ?? 'no disponible';
                    return <td class={v === 'no disponible' ? 'na' : undefined}>{v}</td>;
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {comparison!.derivedNote && <p class="derived-note">{comparison!.derivedNote}</p>}
      </section>
    )}

    <h2 class="block-heading">Los productos, uno a uno</h2>
    <section class="compare-grid">
      {products.map((product) => (
        <article class="compare-card">
          {product.tier && <span class="eyebrow tier-eyebrow" data-cat={cat}><span class="dot"></span>{product.tier}</span>}
          <a
            href={product.amazonUrl}
            target="_blank"
            rel="nofollow sponsored"
            class="compare-image-link photo-surface"
            data-umami-event="amazon-click-imagen"
            data-umami-event-post={postId}
            data-umami-event-producto={product.shortName ?? product.name}
            data-umami-event-tier={product.tier ?? 'sin-tier'}
          >
            <img src={product.image} alt={product.name} loading="lazy" />
          </a>
          <h3 class="compare-name">{product.name}</h3>
          <div class="compare-stats">
            {product.rating && <span>★ {product.rating}</span>}
            {product.reviews && (
              <span
                class={esCompartida(product) ? 'resenas-compartidas' : undefined}
                aria-describedby={esCompartida(product) ? 'nota-resenas' : undefined}
              >
                {product.reviews} reseñas{esCompartida(product) && <sup aria-hidden="true">*</sup>}
              </span>
            )}
            {product.price && <span class="compare-price">{product.price.toFixed(2).replace('.', ',')} €</span>}
          </div>
          <p class="compare-highlight">{product.highlight}</p>
          <a
            href={product.amazonUrl}
            target="_blank"
            rel="nofollow sponsored"
            class="amazon-button"
            data-umami-event="amazon-click"
            data-umami-event-post={postId}
            data-umami-event-producto={product.shortName ?? product.name}
            data-umami-event-tier={product.tier ?? 'sin-tier'}
          >
            Ver en Amazon →
          </a>
        </article>
      ))}
    </section>

    {hayResenasCompartidas && (
      <p class="nota-resenas" id="nota-resenas">
        <span aria-hidden="true">*</span> Amazon muestra el mismo contador de reseñas en
        productos distintos de un mismo vendedor. Cuando esa cifra se repite aquí, no está
        valorando cada aparato por separado: no la uses para compararlos entre sí.
      </p>
    )}

    {pitfalls && pitfalls.length > 0 && (
      <section class="block">
        <h2>Trampas de marketing y errores comunes</h2>
        <div class="pitfalls">
          {pitfalls.map((p) => (
            <div class="pitfall">
              <p class="pitfall-claim"><span class="pitfall-tag">Lo que dice</span>{p.claim}</p>
              <p class="pitfall-reality"><span class="pitfall-tag">Lo que significa</span>{p.reality}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    {verdicts && verdicts.length > 0 && (
      <section class="block">
        <h2>Veredicto por perfil</h2>
        <p class="verdict-intro">No hay un «mejor» absoluto: depende de en qué rango vayas a trabajar.</p>
        <div class="verdicts">
          {verdicts.map((v) => (
            <div class="verdict">
              <span class="eyebrow" data-cat={cat}><span class="dot"></span>{v.profile}</span>
              <p class="verdict-pick">{v.pick}</p>
              <p class="verdict-why">{v.why}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="block methodology">
      <h2>Cómo se ha hecho esta comparativa</h2>
      <p>Los datos de esta página (precios, valoraciones y especificaciones) provienen de la ficha de cada producto en Amazon en la fecha de publicación, y los precios cambian a menudo. <strong>No he probado estos productos</strong>: lo que aporto aquí es la interpretación de sus specs, no una prueba de uso. Cuando un dato no aparece en la ficha, la tabla dice «no disponible» en vez de estimarlo.</p>
      <p>El criterio de selección completo está en la <a href="/metodologia">metodología</a>.</p>
    </section>

    <div class="author-slot">
      <AuthorBox />
    </div>

    <footer class="affiliate-footer">
      <p>
        Participo en el Programa de Afiliados de Amazon. Algunos enlaces en este artículo son de afiliado, lo que significa que recibo una pequeña comisión por las compras realizadas sin coste adicional para ti. Los productos se eligen con un <a href="/metodologia">criterio publicado</a> y no los pruebo en mano.
      </p>
    </footer>
  </main>
</Layout>

<style>
  .post-hero {
    background: var(--ink);
    padding: 3rem 0 2.5rem;
    color: white;
  }
  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .hero-content { text-align: center; }
  .post-title {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 1.25rem 0 1rem;
    color: white;
  }
  .post-meta {
    font-family: var(--font-mono);
    color: #9aa5b1;
    font-size: 0.85rem;
    display: flex;
    justify-content: center;
    gap: 0.85rem;
    align-items: center;
  }
  .post-meta .tick {
    width: 14px;
    height: 1px;
    background: var(--signal);
  }

  .post-main {
    max-width: 960px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 3rem;
  }

  .post-main .prose {
    max-width: 720px;
    margin: 0 auto 2.5rem;
  }

  /* ── Bloques de la plantilla de roundup ─────────────────────────────── */
  .block, .audience, .block-heading {
    max-width: 720px;
    margin-inline: auto;
  }
  .block { margin-bottom: 2.75rem; }
  .block h2, .block-heading {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 1rem;
    line-height: 1.25;
  }
  .block-heading { margin-bottom: 1.25rem; }
  .block p { color: var(--muted); line-height: 1.7; }
  .block strong { color: var(--ink); }
  .block a { color: var(--signal-ink); text-decoration: underline; text-underline-offset: 2px; }

  /* 1. A quién va dirigido */
  .audience {
    border-left: 3px solid var(--signal);
    padding: 0.15rem 0 0.15rem 1.15rem;
    margin-bottom: 2.25rem;
  }
  .audience .eyebrow { margin-bottom: 0.5rem; }
  .audience p {
    margin: 0;
    color: var(--ink);
    font-size: 1.08rem;
    line-height: 1.65;
  }

  /* 2. Qué specs importan */
  .spec-list { margin: 0; display: flex; flex-direction: column; gap: 1.1rem; }
  .spec-item {
    border-bottom: 1px solid var(--line);
    padding-bottom: 1.1rem;
  }
  .spec-item:last-child { border-bottom: none; padding-bottom: 0; }
  .spec-item dt {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--signal-ink);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.4rem;
  }
  .spec-item dd {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  /* 3. Cómo elegir según tu caso */
  .choose-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .choose-list li {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0.85rem;
    align-items: baseline;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.85rem 1.1rem;
  }
  .choose-if { color: var(--muted); }
  .choose-arrow { color: var(--signal); font-weight: 700; }
  .choose-then { color: var(--ink); font-weight: 600; }

  /* 4. Tabla comparativa */
  .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    min-width: 520px;
  }
  .compare-table th, .compare-table td {
    text-align: left;
    padding: 0.7rem 0.85rem;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .compare-table thead th {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--signal-ink);
    background: var(--panel);
    border-bottom: 2px solid var(--line);
    white-space: nowrap;
  }
  .compare-table tbody th {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--ink);
    max-width: 220px;
  }
  .compare-table td { color: var(--muted); font-family: var(--font-mono); font-size: 0.82rem; }
  /* --muted-soft se quedaba en 2.73 de contraste. El hueco de dato es
     información relevante (dice que el fabricante no lo publica), así que
     tiene que leerse: se marca en cursiva, no atenuándolo. */
  .compare-table td.na { font-style: italic; }
  .derived-note {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0.85rem 0 0;
    padding-left: 0.85rem;
    border-left: 2px solid color-mix(in srgb, var(--signal) 45%, transparent);
  }

  /* 6. Trampas de marketing */
  .pitfalls { display: flex; flex-direction: column; gap: 1rem; }
  .pitfall {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 1.1rem 1.25rem;
  }
  .pitfall p { margin: 0; }
  .pitfall-claim { margin-bottom: 0.6rem !important; }
  .pitfall-tag {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-bottom: 0.25rem;
  }
  .pitfall-claim .pitfall-tag { color: var(--muted-soft); }
  .pitfall-claim { color: var(--muted); font-style: italic; }
  .pitfall-reality .pitfall-tag { color: var(--signal-ink); }
  .pitfall-reality { color: var(--ink); }

  /* 7. Veredicto por perfil */
  .verdict-intro { margin: -0.4rem 0 1.1rem; }
  .verdicts { display: flex; flex-direction: column; gap: 1rem; }
  .verdict {
    border: 1px solid var(--line);
    border-left: 3px solid var(--signal);
    border-radius: 8px;
    background: var(--panel);
    padding: 1rem 1.25rem;
  }
  .verdict .eyebrow { margin-bottom: 0.45rem; }
  .verdict-pick {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 0.35rem !important;
  }
  .verdict-why { margin: 0 !important; font-size: 0.93rem; }

  /* 8. Metodología */
  .methodology {
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }
  .methodology h2 { font-size: 1.05rem; }
  .methodology p { font-size: 0.92rem; }

  .compare-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 1.5rem;
    margin: 0 0 3rem;
  }

  /* subgrid alinea entre tarjetas cada franja (etiqueta, foto, nombre, datos,
     texto, botón) aunque los textos ocupen distinto número de líneas. */
  .compare-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1.25rem;
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 6;
    gap: 0.6rem;
    align-content: start;
  }

  .tier-eyebrow { align-items: flex-start; }
  .tier-eyebrow .dot { margin-top: 0.42em; }

  .compare-image-link {
    border: 1px solid var(--line);
    border-radius: 8px;
    aspect-ratio: 4 / 3;
  }
  .compare-image-link img { padding: 0.75rem; }

  .compare-name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
    line-height: 1.35;
  }

  .compare-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
  }
  .resenas-compartidas {
    text-decoration: underline dotted;
    text-underline-offset: 0.2em;
    text-decoration-color: color-mix(in srgb, var(--muted) 55%, transparent);
  }
  .resenas-compartidas sup { text-decoration: none; }
  .nota-resenas {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 1.25rem 0 0;
    padding-left: 0.85rem;
    border-left: 2px solid color-mix(in srgb, var(--signal) 45%, transparent);
  }
  .compare-price {
    color: var(--signal-ink);
    font-weight: 600;
  }

  .compare-highlight {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.55;
    margin: 0;
    flex-grow: 1;
  }

  .amazon-button {
    align-self: flex-start;
    background: var(--amazon);
    color: #1a1200;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.55rem 1.2rem;
    border-radius: 100px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s;
  }
  .amazon-button:hover { background: var(--amazon-ink); color: white; }

  /* La rejilla de comparativa es más ancha que el texto; el autor y el aviso
     vuelven a la columna de lectura. */
  .author-slot {
    max-width: 720px;
    margin: 0 auto;
  }
  .affiliate-footer {
    max-width: 720px;
    margin: 0 auto;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .affiliate-footer a {
    color: var(--signal-ink);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .affiliate-footer p {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--muted);
    text-align: left;
    margin: 0;
  }

  @media (max-width: 720px) {
    .post-hero { padding: 2.25rem 0 1.75rem; }
    .container { padding: 0 1.25rem; }
    .post-main { padding: 1.75rem 1.25rem 2.5rem; }
    .compare-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      margin-bottom: 2.25rem;
    }
    /* En una sola columna no hay nada que alinear entre tarjetas. */
    .compare-card {
      grid-template-rows: none;
      grid-row: auto;
    }
    .block { margin-bottom: 2.25rem; }
    .block h2, .block-heading { font-size: 1.2rem; }
    /* El "si X → prioriza Y" apilado se lee mejor que en tres columnas. */
    .choose-list li {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
    .choose-arrow { display: none; }
    .choose-then::before { content: '→ '; color: var(--signal); font-weight: 700; }
  }
</style>
