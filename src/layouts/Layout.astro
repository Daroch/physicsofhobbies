---
import '../styles/global.css';
import Header from '../components/Header.astro';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';

interface Props {
	title: string;
	description: string;
	image?: string;
	type?: 'website' | 'article';
	structuredData?: Record<string, unknown>;
}
const { title, description, image = '/images/default-physics.png', type = 'website', structuredData } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/images/favicon-32x32.png" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content={type} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content="Physics of Hobbies" />
		<meta property="og:locale" content="es_ES" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		{structuredData && (
			<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		)}

		<link rel="stylesheet" href="/katex/katex.min.css" />
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<div class="trace-rule"></div>
			<div class="footer-inner">
				<span class="footer-mark">P·H</span>
				<div class="footer-links">
					<a href="/privacidad">Privacidad</a>
					<a href="/sobre-mi">Sobre el proyecto</a>
				</div>
				<p class="footer-copy">© {new Date().getFullYear()} Physics of Hobbies</p>
			</div>
		</footer>
	</body>
</html>

<style is:global>
  body {
    background-color: var(--paper);
    color: var(--ink);
    margin: 0;
    font-family: var(--font-body);
  }
  /* `main` va a sangre completa para que las bandas oscuras (hero de portada y
     de post) continúen visualmente el navbar y el footer. Cada sección se
     autolimita con `.wrap` o con su propio max-width; así ninguna necesita el
     truco `calc(-50vw + 50%)`, que desbordaba el ancho de la barra de scroll. */
  main {
    width: 100%;
  }
</style>

<style>
  .site-footer {
    margin-top: 4rem;
    background: var(--ink);
    color: var(--muted-soft);
  }
  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }
  .footer-mark {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    color: var(--signal);
    border: 1px solid color-mix(in srgb, var(--signal) 40%, transparent);
    border-radius: 4px;
    padding: 0.15rem 0.5rem;
  }
  .footer-links {
    display: flex;
    gap: 1.5rem;
  }
  .footer-links a {
    color: #cbd2d9;
    text-decoration: none;
    font-size: 0.9rem;
    font-family: var(--font-mono);
  }
  .footer-links a:hover { color: var(--signal); }
  .footer-copy {
    font-size: 0.8rem;
    color: #6b7580;
    margin: 0;
  }
</style>
