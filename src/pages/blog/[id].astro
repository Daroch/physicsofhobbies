---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const cat = (post.data.category || 'general').toLowerCase();

const { Content } = await render(post);

const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  image: new URL(post.data.image || '/images/default-physics.png', Astro.site).toString(),
  datePublished: post.data.pubDate.toISOString(),
  author: {
    '@type': 'Person',
    name: 'Álvaro',
    url: new URL('/sobre-mi', Astro.site).toString(),
  },
  publisher: {
    '@type': 'Organization',
    name: 'Physics of Hobbies',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/images/favicon-32x32.png', Astro.site).toString(),
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, Astro.site).toString(),
  },
};
---

<Layout
  title={`${post.data.title} — Physics of Hobbies`}
  description={post.data.description}
  image={post.data.image}
  type="article"
  structuredData={articleStructuredData}
>
  <div class="post-hero grid-paper">
    <div class="container">
      <div class="hero-content">
        <span class="eyebrow" data-cat={cat}><span class="dot"></span>{post.data.category || 'Física'}</span>
        <h1 class="post-title">{post.data.title}</h1>
        <div class="post-meta">
          <time>{post.data.pubDate ? post.data.pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }) : 'Fecha no disponible'}</time>
          <span class="tick"></span>
          <span>Lectura de 5 min</span>
        </div>
      </div>
    </div>
    <div class="trace-rule"></div>
  </div>

  <main class="post-main">
    <article class="prose prose-slate lg:prose-lg mx-auto prose-headings:font-bold prose-a:text-[color:var(--signal-ink)] prose-img:rounded-lg">

      {post.data.image && (
        <div class="image-panel grid-paper-light">
          <img src={post.data.image} alt={post.data.title} />
        </div>
      )}

      <Content />

      {post.data.amazonUrl && (
        <div class="amazon-cta">
          <a href={post.data.amazonUrl} target="_blank" rel="nofollow sponsored" class="amazon-image-link grid-paper-light">
            <img
              src={post.data.image}
              alt={post.data.title}
            />
          </a>
          <div class="amazon-cta-body">
            <span class="eyebrow amazon-eyebrow"><span class="dot"></span>Producto recomendado en este artículo</span>
            <p class="amazon-title">{post.data.title}</p>
            <a href={post.data.amazonUrl} target="_blank" rel="nofollow sponsored" class="amazon-button">
              Ver en Amazon →
            </a>
          </div>
        </div>
      )}

      <footer class="affiliate-footer">
        <p>
        Participo en el Programa de Afiliados de Amazon. Algunos enlaces en este artículo son de afiliado, lo que significa que recibo una pequeña comisión por las compras realizadas sin coste adicional para ti. Esto ayuda a mantener el laboratorio activo.
        </p>
      </footer>
    </article>
  </main>
</Layout>

<style>
  .post-hero {
    background: var(--ink);
    padding: 3rem 0 2.5rem;
    color: white;
  }
  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .hero-content { text-align: center; }
  .post-title {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 1.25rem 0 1rem;
    color: white;
  }
  .post-meta {
    font-family: var(--font-mono);
    color: #9aa5b1;
    font-size: 0.85rem;
    display: flex;
    justify-content: center;
    gap: 0.85rem;
    align-items: center;
  }
  .post-meta .tick {
    width: 14px;
    height: 1px;
    background: var(--signal);
  }

  .post-main {
    max-width: 720px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 3rem;
  }

  .image-panel {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--paper);
    padding: 1.5rem;
    margin: 0 0 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .image-panel img {
    max-height: 380px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    margin: 0;
  }

  /* Bloque CTA de Amazon */
  .amazon-cta {
    margin-top: 3rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    gap: 1.5rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .amazon-image-link {
    flex: none;
    width: 120px;
    height: 120px;
    border-radius: 8px;
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .amazon-image-link img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    padding: 0.5rem;
    margin: 0;
  }
  .amazon-cta-body {
    flex: 1;
    min-width: 200px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .amazon-eyebrow { color: var(--amazon-ink); }
  .amazon-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink);
    line-height: 1.4;
  }
  .amazon-button {
    align-self: flex-start;
    background: var(--amazon);
    color: #1a1200;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.6rem 1.4rem;
    border-radius: 100px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s;
  }
  .amazon-button:hover { background: var(--amazon-ink); color: white; }

  .affiliate-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .affiliate-footer p {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--muted-soft);
    text-align: left;
    margin: 0;
  }
</style>
