---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import RoundupLayout from '../../layouts/RoundupLayout.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import { SITE, authorSchema } from '../../config/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const cat = (post.data.category || 'general').toLowerCase();

const { Content } = await render(post);
const isRoundup = post.data.type === 'roundup';
const fallbackImage = post.data.image || post.data.products?.[0]?.image || '/images/default-physics.png';

const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  image: new URL(fallbackImage, Astro.site).toString(),
  datePublished: post.data.pubDate.toISOString(),
  // Solo si hubo revisión real. Emitir `dateModified` igual a `datePublished`
  // en todos los posts es ruido que no dice nada.
  ...(post.data.updatedDate && { dateModified: post.data.updatedDate.toISOString() }),
  author: authorSchema(Astro.site),
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    logo: {
      '@type': 'ImageObject',
      url: new URL(SITE.logo, Astro.site).toString(),
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, Astro.site).toString(),
  },
};
---

{isRoundup ? (
  <RoundupLayout
    title={`${post.data.title} — Physics of Hobbies`}
    postId={post.id}
    heading={post.data.title}
    description={post.data.description}
    image={fallbackImage}
    category={post.data.category}
    pubDate={post.data.pubDate}
    updatedDate={post.data.updatedDate}
    products={post.data.products ?? []}
    audience={post.data.audience}
    specsThatMatter={post.data.specsThatMatter}
    chooseBy={post.data.chooseBy}
    comparison={post.data.comparison}
    pitfalls={post.data.pitfalls}
    verdicts={post.data.verdicts}
    structuredData={articleStructuredData}
  >
    <Content />
  </RoundupLayout>
) : (
<Layout
  title={`${post.data.title} — Physics of Hobbies`}
  description={post.data.description}
  image={post.data.image}
  type="article"
  structuredData={articleStructuredData}
>
  <div class="post-hero grid-paper">
    <div class="container">
      <div class="hero-content">
        <span class="eyebrow" data-cat={cat}><span class="dot"></span>{post.data.category || 'Física'}</span>
        <h1 class="post-title">{post.data.title}</h1>
        <div class="post-meta">
          <time>{post.data.pubDate ? post.data.pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }) : 'Fecha no disponible'}</time>
          {post.data.updatedDate && (
            <>
              <span class="tick"></span>
              <span>Revisado el <time>{post.data.updatedDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}</time></span>
            </>
          )}
          <span class="tick"></span>
          <span>Lectura de 5 min</span>
        </div>
      </div>
    </div>
    <div class="trace-rule"></div>
  </div>

  <main class="post-main">
    <article class="prose prose-slate lg:prose-lg mx-auto prose-headings:font-bold prose-a:text-[color:var(--signal-ink)] prose-img:rounded-lg">

      {post.data.image && (
        <div class="image-panel photo-surface">
          <img src={post.data.image} alt={post.data.title} />
        </div>
      )}

      <Content />

      {post.data.amazonUrl && (
        <div class="amazon-cta">
          <a
            href={post.data.amazonUrl}
            target="_blank"
            rel="nofollow sponsored"
            class="amazon-image-link photo-surface"
            data-umami-event="amazon-click-imagen"
            data-umami-event-post={post.id}
            data-umami-event-producto={post.data.productName ?? post.data.title}
          >
            <img
              src={post.data.image}
              alt={post.data.productName ?? post.data.title}
            />
          </a>
          <div class="amazon-cta-body">
            <span class="eyebrow amazon-eyebrow"><span class="dot"></span>Producto recomendado en este artículo</span>
            <p class="amazon-title">{post.data.productName ?? post.data.title}</p>
            <a
              href={post.data.amazonUrl}
              target="_blank"
              rel="nofollow sponsored"
              class="amazon-button"
              data-umami-event="amazon-click"
              data-umami-event-post={post.id}
              data-umami-event-producto={post.data.productName ?? post.data.title}
            >
              Ver en Amazon →
            </a>
          </div>
        </div>
      )}

      <AuthorBox />

      {post.data.amazonUrl && (
        <footer class="affiliate-footer">
          <p>
          Participo en el Programa de Afiliados de Amazon. Algunos enlaces en este artículo son de afiliado, lo que significa que recibo una pequeña comisión por las compras realizadas sin coste adicional para ti. Los productos se eligen con un <a href="/metodologia/">criterio publicado</a> y no los pruebo en mano.
          </p>
        </footer>
      )}
    </article>
  </main>
</Layout>
)}

<style>
  .post-hero {
    background: var(--ink);
    padding: 3rem 0 2.5rem;
    color: white;
  }
  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .hero-content { text-align: center; }
  .post-title {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 1.25rem 0 1rem;
    color: white;
  }
  .post-meta {
    font-family: var(--font-mono);
    color: #9aa5b1;
    font-size: 0.85rem;
    display: flex;
    justify-content: center;
    gap: 0.85rem;
    align-items: center;
  }
  .post-meta .tick {
    width: 14px;
    height: 1px;
    background: var(--signal);
  }

  .post-main {
    max-width: 720px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 3rem;
  }

  .image-panel {
    border: 1px solid var(--line);
    border-radius: 12px;
    /* Altura fija (no max-height sobre la foto): así todos los posts abren
       con el mismo bloque, sin importar si la foto es apaisada o vertical. */
    height: clamp(230px, 42vw, 400px);
    padding: 1.5rem;
    margin: 0 0 2.5rem;
  }
  .image-panel img { margin: 0; }

  /* Bloque CTA de Amazon */
  .amazon-cta {
    margin-top: 3rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    gap: 1.5rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .amazon-image-link {
    flex: none;
    width: 120px;
    height: 120px;
    border-radius: 8px;
    border: 1px solid var(--line);
  }
  .amazon-image-link img {
    padding: 0.5rem;
    margin: 0;
  }
  .amazon-cta-body {
    flex: 1;
    min-width: 200px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .amazon-eyebrow { color: var(--amazon-ink); }
  .amazon-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink);
    line-height: 1.4;
  }
  .amazon-button {
    align-self: flex-start;
    background: var(--amazon);
    color: #1a1200;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.6rem 1.4rem;
    border-radius: 100px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s;
  }
  .amazon-button:hover { background: var(--amazon-ink); color: white; }

  .affiliate-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .affiliate-footer p {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.5;
    /* --muted-soft daba 2.73 de contraste sobre el papel: por debajo de AA, y
       es justo el aviso legal de afiliación, que debe leerse. --muted da 5.32. */
    color: var(--muted);
    text-align: left;
    margin: 0;
  }
  .affiliate-footer a {
    color: var(--signal-ink);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 720px) {
    .post-hero { padding: 2.25rem 0 1.75rem; }
    .container { padding: 0 1.25rem; }
    .post-main { padding: 1.75rem 1.25rem 2.5rem; }
    .image-panel { padding: 1rem; margin-bottom: 1.75rem; }
    /* En móvil la foto y el texto del CTA se apilan; centrarlos evita que la
       miniatura quede descolgada a la izquierda. */
    .amazon-cta {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding: 1.25rem;
    }
    .amazon-image-link { width: 100%; height: 150px; }
  }
</style>
